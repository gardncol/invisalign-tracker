{
  "expo": {
    "name": "Invisalign Tracker",
    "slug": "invisalign-tracker",
    "scheme": "invisalign-tracker",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "bundleIdentifier": "com.colingardner.invisalign-tracker",
      "infoPlist": {
        "CFBundleDisplayName": "Tray Tracker"
      }
    },
    "android": {
      "package": "com.colingardner.invisaligntracker"
    }
  }
}
